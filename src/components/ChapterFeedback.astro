---
// One-tap chapter feedback at the completion moment. Anonymous, once per
// chapter per browser. Sparse by nature — but every thumbs-down is an
// editorial finding, and the monthly edition is the action.
interface Props {
  accent?: 'claw' | 'biz';
}
const { accent = 'claw' } = Astro.props;
const thumbClass =
  accent === 'biz'
    ? 'p-2.5 rounded-full border border-dark-700/60 text-dark-400 hover:text-biz-300 hover:border-biz-500/40 hover:bg-biz-500/10 transition-colors'
    : 'p-2.5 rounded-full border border-dark-700/60 text-dark-400 hover:text-claw-300 hover:border-claw-500/40 hover:bg-claw-500/10 transition-colors';
---

<div id="chapter-fb" class="mt-14 flex items-center justify-center gap-4 text-sm text-dark-400">
  <span id="fb-q">Was this chapter worth your time?</span>
  <button id="fb-up" class={thumbClass} aria-label="Thumbs up">
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M2 20h2c.55 0 1-.45 1-1v-9c0-.55-.45-1-1-1H2v11zm19.83-7.12c.11-.25.17-.52.17-.8V11c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66-.23-.45-.52-.86-.88-1.22L14 2 7.59 8.41C7.21 8.79 7 9.3 7 9.83v7.84C7 18.95 8.05 20 9.34 20h8.11c.7 0 1.36-.37 1.72-.97l2.66-6.15z"/></svg>
  </button>
  <button id="fb-down" class={thumbClass} aria-label="Thumbs down">
    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 4h-2c-.55 0-1 .45-1 1v9c0 .55.45 1 1 1h2V4zM2.17 11.12c-.11.25-.17.52-.17.8V13c0 1.1.9 2 2 2h5.5l-.92 4.65c-.05.22-.02.46.08.66.23.45.52.86.88 1.22L10 22l6.41-6.41c.38-.38.59-.89.59-1.42V6.34C17 5.05 15.95 4 14.66 4H6.56c-.71 0-1.36.37-1.72.97l-2.67 6.15z"/></svg>
  </button>
</div>

<script is:inline>
  (function () {
    var wrap = document.getElementById('chapter-fb');
    if (!wrap) return;
    var key = 'cw_fb_' + location.pathname;
    function thank() {
      wrap.innerHTML = '<span class="text-dark-500">Logged. The next edition reads this. Thank you.</span>';
    }
    try { if (localStorage.getItem(key)) { thank(); return; } } catch (e) {}
    function send(vote) {
      try { localStorage.setItem(key, vote); } catch (e) {}
      try {
        if (window.__statsUrl && window.__statsKey) {
          fetch(window.__statsUrl + '/rest/v1/book_events?apikey=' + encodeURIComponent(window.__statsKey), {
            method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event_type: 'answer', path: location.pathname.slice(0, 190), target: 'rating:' + vote, device: window.innerWidth < 768 ? 'mobile' : 'desktop' }),
          }).catch(function () {});
        }
      } catch (e) {}
      thank();
    }
    document.getElementById('fb-up').addEventListener('click', function () { send('up'); });
    document.getElementById('fb-down').addEventListener('click', function () { send('down'); });
  })();
</script>
