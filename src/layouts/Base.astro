---
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  robots?: string;
  publishedDate?: string;
  modifiedDate?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "The Agentic AI Handbook — An open-source guide to autonomous AI agents and digital employees",
  image = '/og-cover.svg',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  publishedDate,
  modifiedDate,
  structuredData,
} = Astro.props;

const siteName = 'Clawable';
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImageUrl = new URL(image, siteUrl).toString();
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const schemaList = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: new URL('/', siteUrl).toString(),
  logo: new URL('/favicon.svg', siteUrl).toString(),
  sameAs: [
    'https://github.com/magnusfroste',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL('/', siteUrl).toString(),
  description,
  inLanguage: 'en',
  publisher: orgSchema,
};

const allSchemas = [orgSchema, webSiteSchema, ...schemaList];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1020" />
    <meta name="color-scheme" content="dark" />
    <meta name="language" content="en" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={description} />

    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {type === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@clawable" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-dark-950 text-dark-200 font-sans antialiased">
    <slot />
    {import.meta.env.PUBLIC_STATS_URL && import.meta.env.PUBLIC_STATS_KEY && (
      <script is:inline define:vars={{ statsUrl: import.meta.env.PUBLIC_STATS_URL, statsKey: import.meta.env.PUBLIC_STATS_KEY }}>
        // Anonymous, aggregate-only reading analytics. No cookies, no IDs, no IP stored.
        // The visit id lives in sessionStorage only (dies with the tab) — per-visit
        // grouping without any cross-visit tracking.
        // Dev sessions must not pollute production stats: leaving the globals unset
        // also silences every other sender (listen, feedback, survey).
        if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') { /* dev */ } else {
        window.__statsUrl = statsUrl;
        window.__statsKey = statsKey;
        }
        (function () {
          if (navigator.webdriver) return;
          if (!window.__statsUrl) return;
          var activeMs = 0;
          var lastVisible = document.visibilityState === 'visible' ? Date.now() : null;
          var maxDepth = 0;
          var sent = false;

          var visit;
          try {
            visit = sessionStorage.getItem('cw_visit');
            if (!visit) {
              visit = Math.random().toString(36).slice(2, 12);
              sessionStorage.setItem('cw_visit', visit);
            }
          } catch (e) { visit = null; }

          function beacon(payload) {
            // fetch+keepalive survives page unload AND passes CORS preflight —
            // sendBeacon with JSON is silently dropped cross-origin.
            fetch(statsUrl + '/rest/v1/book_events?apikey=' + encodeURIComponent(statsKey), {
              method: 'POST', keepalive: true,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            }).catch(function () {});
          }

          function updateDepth() {
            var doc = document.documentElement;
            var scrollable = doc.scrollHeight - window.innerHeight;
            var d = scrollable <= 0 ? 100 : Math.round(((window.scrollY || doc.scrollTop) / scrollable) * 100);
            if (d > maxDepth) maxDepth = Math.min(d, 100);
          }

          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') {
              lastVisible = Date.now();
            } else {
              if (lastVisible) activeMs += Date.now() - lastVisible;
              lastVisible = null;
              send();
            }
          });
          window.addEventListener('scroll', updateDepth, { passive: true });
          window.addEventListener('pagehide', send);

          // Outbound clicks → reader actions (target = hostname only)
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            try {
              var u = new URL(a.href, location.href);
              if (u.host !== location.host && /^https?:$/.test(u.protocol)) {
                beacon({
                  event_type: 'click',
                  path: location.pathname.slice(0, 190),
                  target: u.hostname.slice(0, 100),
                  visit: visit,
                  device: window.innerWidth < 768 ? 'mobile' : 'desktop',
                });
              }
            } catch (err) {}
          }, { capture: true, passive: true });

          function send() {
            if (sent) return;
            sent = true;
            updateDepth();
            if (lastVisible) activeMs += Date.now() - lastVisible;
            beacon({
              event_type: 'view',
              path: location.pathname.slice(0, 190),
              depth: maxDepth,
              seconds: Math.min(Math.round(activeMs / 1000), 7200),
              referrer: (document.referrer || '').split('/').slice(0, 3).join('/').slice(0, 190) || null,
              device: window.innerWidth < 768 ? 'mobile' : 'desktop',
              visit: visit,
            });
          }
        })();
      </script>
    )}
    {import.meta.env.PUBLIC_STATS_URL && import.meta.env.PUBLIC_STATS_KEY && import.meta.env.PUBLIC_SURVEY === 'on' && (
      <script is:inline define:vars={{ statsUrl: import.meta.env.PUBLIC_STATS_URL, statsKey: import.meta.env.PUBLIC_STATS_KEY }}>
        // Optional 3-question reader card. Anonymous. Shows once, on the reader's
        // 2nd+ chapter at 50% scroll, always skippable. Enable: PUBLIC_SURVEY=on.
        (function () {
          if (navigator.webdriver) return;
          if (!/^\/(business|builder)\//.test(location.pathname)) return;
          try {
            if (localStorage.getItem('cw_survey_done')) return;
            var count = (parseInt(sessionStorage.getItem('cw_ch') || '0', 10) || 0) + 1;
            sessionStorage.setItem('cw_ch', String(count));
            if (count < 2) return;
          } catch (e) { return; }

          var QUESTIONS = [
            { q: 'What best describes you?', key: 'role',
              a: [['Business leader', 'leader'], ['Engineer / builder', 'builder'], ['Investor / analyst', 'analyst'], ['Curious reader', 'curious']] },
            { q: 'Where is your organization on agentic AI?', key: 'stage',
              a: [['Just learning', 'learning'], ['Exploring', 'exploring'], ['Running a pilot', 'pilot'], ['In production', 'production']] },
            { q: 'Likely to start an agent project within 6 months?', key: 'intent',
              a: [['Yes', 'yes'], ['Maybe', 'maybe'], ['No', 'no']] },
          ];
          var idx = 0, shown = false;

          function beacon(target) {
            fetch(statsUrl + '/rest/v1/book_events?apikey=' + encodeURIComponent(statsKey), {
              method: 'POST', keepalive: true,
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ event_type: 'answer', path: location.pathname.slice(0, 190), target: target.slice(0, 100),
                device: window.innerWidth < 768 ? 'mobile' : 'desktop' }),
            }).catch(function () {});
          }
          function done() {
            try { localStorage.setItem('cw_survey_done', '1'); } catch (e) {}
            var el = document.getElementById('cw-survey');
            if (el) { el.style.transform = 'translateY(120%)'; setTimeout(function () { el.remove(); }, 400); }
          }
          function render() {
            var el = document.getElementById('cw-survey');
            if (idx >= QUESTIONS.length) {
              el.querySelector('#cw-body').innerHTML = '<p style="margin:0;font-weight:600;color:#fff">Thank you — enjoy the book. 🦞</p>';
              setTimeout(done, 1400);
              return;
            }
            var item = QUESTIONS[idx];
            el.querySelector('#cw-body').innerHTML =
              '<p style="margin:0 0 10px;font-weight:600;color:#fff">' + item.q + '</p>' +
              '<div style="display:flex;flex-wrap:wrap;gap:8px">' +
              item.a.map(function (pair) {
                return '<button data-v="' + item.key + ':' + pair[1] + '" style="border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);color:#e5e5e5;border-radius:9999px;padding:7px 14px;font-size:13px;cursor:pointer">' + pair[0] + '</button>';
              }).join('') + '</div>';
            el.querySelectorAll('#cw-body button').forEach(function (b) {
              b.addEventListener('click', function () { beacon(b.dataset.v); idx++; render(); });
            });
          }
          function show() {
            if (shown) return; shown = true;
            var el = document.createElement('div');
            el.id = 'cw-survey';
            el.style.cssText = 'position:fixed;left:12px;right:12px;bottom:12px;z-index:60;max-width:460px;margin:0 auto;background:#111214;border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:16px;box-shadow:0 12px 40px rgba(0,0,0,.5);transition:transform .4s ease;font-family:inherit';
            el.innerHTML =
              '<p style="margin:0 0 8px;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:#8b8b93">Three taps — anonymous, as always</p>' +
              '<div id="cw-body"></div>' +
              '<button id="cw-skip" style="margin-top:12px;background:none;border:none;color:#8b8b93;font-size:13px;cursor:pointer;padding:0;text-decoration:underline">Continue reading →</button>';
            document.body.appendChild(el);
            el.querySelector('#cw-skip').addEventListener('click', done);
            render();
          }
          window.addEventListener('scroll', function onScroll() {
            var doc = document.documentElement;
            var scrollable = doc.scrollHeight - window.innerHeight;
            if (scrollable > 0 && (window.scrollY / scrollable) > 0.5) {
              window.removeEventListener('scroll', onScroll);
              show();
            }
          }, { passive: true });
        })();
      </script>
    )}
  </body>
</html>
