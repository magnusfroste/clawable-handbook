---
import Base from '../layouts/Base.astro';

const statsUrl = import.meta.env.PUBLIC_STATS_URL ?? '';
const statsKey = import.meta.env.PUBLIC_STATS_KEY ?? '';
---

<Base title="Analytics" description="Aggregated, anonymous reading analytics." robots="noindex,nofollow">
  <main class="pt-16 pb-20 max-w-5xl mx-auto px-6">
    <h1 class="text-3xl font-bold text-white mb-2">Reading Analytics</h1>
    <p class="text-dark-400 mb-8 text-sm">
      Aggregated and anonymous — no cookies, no identifiers, no IP addresses.
      Completion = share of views that scrolled past 90%.
    </p>

    <div id="summary" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10"></div>

    <section id="trend-section" class="hidden mb-10">
      <h2 class="text-xl font-semibold text-white mb-4">Views — last 30 days</h2>
      <div id="trend" class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4"></div>
    </section>

    <section id="funnels"></section>

    <section id="tables"></section>

    <section id="ref-section" class="hidden mt-10">
      <h2 class="text-xl font-semibold text-white mb-4">Where readers come from</h2>
      <div id="referrers" class="rounded-xl border border-dark-800/50 overflow-hidden"></div>
    </section>

    <p id="status" class="text-dark-500 text-sm mt-8">Loading…</p>
  </main>

  <script is:inline define:vars={{ statsUrl, statsKey }}>
    (async function () {
      const statusEl = document.getElementById('status');
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      if (!statsUrl || !statsKey) {
        statusEl.textContent = 'Analytics is not configured (PUBLIC_STATS_URL / PUBLIC_STATS_KEY missing at build time).';
        return;
      }
      const headers = { apikey: statsKey, authorization: `Bearer ${statsKey}` };
      const get = async (q) => {
        const res = await fetch(`${statsUrl}/rest/v1/${q}`, { headers });
        if (!res.ok) throw new Error(`HTTP ${res.status} on ${q.split('?')[0]}`);
        return res.json();
      };

      try {
        const [rows, daily, refs, visitStats, clicks, segments, survey, hours, agents, listens] = await Promise.all([
          get('book_stats?select=*&order=views.desc'),
          get('book_stats_daily?select=*&order=day.asc').catch(() => []),
          get('book_referrers?select=*&order=views.desc&limit=15').catch(() => []),
          get('book_visit_stats?select=*').catch(() => []),
          get('book_clicks?select=*&order=clicks.desc&limit=15').catch(() => []),
          get('book_visit_segments?select=*').catch(() => []),
          get('book_survey?select=*').catch(() => []),
          get('book_hours?select=*').catch(() => []),
          get('book_agent_stats?select=*&order=events.desc').catch(() => []),
          get('book_listens?select=*&order=starts.desc').catch(() => []),
        ]);
        if (!rows.length) { statusEl.textContent = 'No data yet. Come back after the first readers.'; return; }

        // ---- Summary cards ----
        const totalViews = rows.reduce((s, r) => s + Number(r.views), 0);
        const totalMinutes = Math.round(rows.reduce((s, r) => s + Number(r.views) * Number(r.avg_seconds), 0) / 60);
        const chapters = rows.filter((r) => /^\/(business|builder)\//.test(r.path));
        const avgCompletion = chapters.length
          ? Math.round(chapters.reduce((s, r) => s + Number(r.completion_pct), 0) / chapters.length) : 0;
        const mobileViews = rows.reduce((s, r) => s + Number(r.mobile_views || 0), 0);
        const vs = visitStats[0] || null;
        const engagedTotal = rows.reduce((s, r) => s + Number(r.engaged_views || 0), 0);
        // Week-over-week from daily data
        let wow = null;
        if (daily.length) {
          const day = (offset) => new Date(Date.now() - offset * 864e5).toISOString().slice(0, 10);
          const sum = (from, to) => daily.filter((d) => d.day >= from && d.day < to).reduce((s, d) => s + Number(d.views), 0);
          const thisWeek = sum(day(7), day(-1)); const lastWeek = sum(day(14), day(7));
          if (lastWeek > 0) wow = Math.round((100 * (thisWeek - lastWeek)) / lastWeek);
        }
        document.getElementById('summary').innerHTML = [
          ['Total views', totalViews.toLocaleString()],
          ['Engaged sessions (3+ min)', engagedTotal.toLocaleString()],
          ['Total reading time', `${totalMinutes.toLocaleString()} min`],
          ['Avg chapter completion', `${avgCompletion}%`],
          ['Mobile share', `${Math.round((100 * mobileViews) / totalViews)}%`],
          ...(wow !== null ? [['Views week-over-week', `${wow >= 0 ? '+' : ''}${wow}%`]] : []),
          ...(vs ? [
            ['Visits', Number(vs.visits).toLocaleString()],
            ['Pages / visit', vs.pages_per_visit],
            ['Deep visits (3+ pages)', `${vs.deep_visit_pct}%`],
            ['Read both editions', `${vs.cross_edition_pct}%`],
          ] : []),
        ].map(([label, value]) => `
          <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
            <div class="text-2xl font-bold text-white">${value}</div>
            <div class="text-xs text-dark-400 mt-1">${label}</div>
          </div>`).join('');

        // ---- Business vs Builder — the two audiences ----
        const trackStats = (prefix) => {
          const list = rows.filter((r) => r.path.startsWith(prefix));
          if (!list.length) return null;
          const views = list.reduce((s, r) => s + Number(r.views), 0);
          const wavg = (field) => Math.round(list.reduce((s, r) => s + Number(r[field]) * Number(r.views), 0) / views);
          return { views, time: wavg('avg_seconds'), completion: wavg('completion_pct'),
                   mobile: Math.round((100 * list.reduce((s, r) => s + Number(r.mobile_views || 0), 0)) / views) };
        };
        const seg = (name) => segments.find((s) => s.segment === name);
        const biz = trackStats('/business'); const bld = trackStats('/builder');
        if (biz || bld) {
          const col = (label, t, s, color) => `
            <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-5">
              <h3 class="font-semibold ${color} mb-3">${label}</h3>
              ${!t ? '<p class="text-dark-500 text-sm">No data yet.</p>' : `
              <dl class="grid grid-cols-2 gap-y-2 text-sm">
                <dt class="text-dark-400">Views</dt><dd class="text-right text-white font-semibold">${t.views.toLocaleString()}</dd>
                <dt class="text-dark-400">Avg reading time</dt><dd class="text-right text-white font-semibold">${Math.floor(t.time / 60)}m ${t.time % 60}s</dd>
                <dt class="text-dark-400">Avg completion</dt><dd class="text-right text-white font-semibold">${t.completion}%</dd>
                <dt class="text-dark-400">Mobile share</dt><dd class="text-right text-white font-semibold">${t.mobile}%</dd>
                ${s ? `
                <dt class="text-dark-400">Visits (this track only)</dt><dd class="text-right text-white font-semibold">${Number(s.visits).toLocaleString()}</dd>
                <dt class="text-dark-400">Pages / visit</dt><dd class="text-right text-white font-semibold">${s.pages_per_visit}</dd>
                <dt class="text-dark-400">Deep visits (3+)</dt><dd class="text-right text-white font-semibold">${s.deep_visit_pct}%</dd>` : ''}
              </dl>`}
            </div>`;
          const both = seg('both');
          document.getElementById('summary').insertAdjacentHTML('afterend', `
            <section class="mb-10">
              <h2 class="text-xl font-semibold text-white mb-1">The two audiences</h2>
              <p class="text-xs text-dark-500 mb-4">Business = leaders. Builder = engineers. ${both ? `<span class="text-claw-400">${Number(both.visits).toLocaleString()} visits read both editions (${both.pages_per_visit} pages/visit)</span> — the decision-maker-plus-CTO signal.` : ''}</p>
              <div class="grid md:grid-cols-2 gap-4">
                ${col('Business Edition', biz, seg('business'), 'text-biz-400')}
                ${col('Builder Edition', bld, seg('builder'), 'text-claw-400')}
              </div>
            </section>`);
        }

        // ---- Daily trend (last 30 days) ----
        if (daily.length) {
          const cutoff = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
          const recent = daily.filter((d) => d.day >= cutoff);
          if (recent.length) {
            const max = Math.max(...recent.map((d) => d.views));
            document.getElementById('trend-section').classList.remove('hidden');
            document.getElementById('trend').innerHTML = `
              <div class="flex items-end gap-1 h-32">
                ${recent.map((d) => `
                  <div class="flex-1 flex flex-col items-center gap-1" title="${esc(d.day)}: ${d.views} views">
                    <span class="text-[10px] text-dark-500">${d.views}</span>
                    <div class="w-full rounded-t bg-claw-500/70 hover:bg-claw-400" style="height:${Math.max(4, Math.round((d.views / max) * 100))}%"></div>
                  </div>`).join('')}
              </div>
              <div class="flex justify-between text-[10px] text-dark-500 mt-2">
                <span>${esc(recent[0].day)}</span><span>${esc(recent[recent.length - 1].day)}</span>
              </div>`;
          }
        }

        // ---- Reading funnel per track (numbered chapters, in order) ----
        const funnel = (track, label) => {
          const list = rows
            .filter((r) => r.path.startsWith(`/${track}/`) && !/appendix/.test(r.path))
            .sort((a, b) => a.path.localeCompare(b.path));
          if (list.length < 2) return '';
          const first = Number(list[0].views) || 1;
          return `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">${label} — reading funnel</h2>
            <p class="text-xs text-dark-500 mb-4">Retention vs the first chapter. Where the bars shrink fast is where readers stop.</p>
            <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4 flex flex-col gap-1.5">
              ${list.map((r) => {
                const pct = Math.min(100, Math.round((Number(r.views) / first) * 100));
                const slug = r.path.split('/').pop();
                return `
                  <div class="flex items-center gap-3 text-xs">
                    <span class="w-44 shrink-0 truncate font-mono text-dark-400">${esc(slug)}</span>
                    <div class="flex-1 bg-dark-800 rounded h-3.5">
                      <div class="h-3.5 rounded bg-gradient-to-r from-claw-600 to-claw-400" style="width:${pct}%"></div>
                    </div>
                    <span class="w-20 text-right text-dark-300">${Number(r.views).toLocaleString()} · ${pct}%</span>
                  </div>`;
              }).join('')}
            </div>`;
        };
        document.getElementById('funnels').innerHTML = funnel('business', 'Business Edition') + funnel('builder', 'Builder Edition');

        // ---- Per-track tables ----
        const table = (name, list) => !list.length ? '' : `
          <h2 class="text-xl font-semibold text-white mt-10 mb-4">${name}</h2>
          <div class="overflow-x-auto rounded-xl border border-dark-800/50">
            <table class="w-full text-sm">
              <thead class="bg-dark-900/60 text-dark-400 text-left">
                <tr><th class="p-3">Page</th><th class="p-3 text-right">Views</th><th class="p-3 text-right">Avg depth</th><th class="p-3 text-right">Avg time</th><th class="p-3 text-right">Completion</th></tr>
              </thead>
              <tbody>
                ${list.map((r) => `
                  <tr class="border-t border-dark-800/40">
                    <td class="p-3 text-dark-200 font-mono text-xs">${esc(r.path)}</td>
                    <td class="p-3 text-right text-white">${Number(r.views).toLocaleString()}</td>
                    <td class="p-3 text-right">
                      <span class="inline-block w-24 bg-dark-800 rounded h-2 align-middle mr-2"><span class="block h-2 rounded bg-claw-500" style="width:${r.avg_depth}%"></span></span>${r.avg_depth}%
                    </td>
                    <td class="p-3 text-right text-dark-300">${Math.round(r.avg_seconds / 60)}m ${r.avg_seconds % 60}s</td>
                    <td class="p-3 text-right text-dark-300">${r.completion_pct}%</td>
                  </tr>`).join('')}
              </tbody>
            </table>
          </div>`;
        document.getElementById('tables').innerHTML =
          table('Business Edition', rows.filter((r) => r.path.startsWith('/business'))) +
          table('Builder Edition', rows.filter((r) => r.path.startsWith('/builder'))) +
          table('Other pages', rows.filter((r) => !r.path.startsWith('/business') && !r.path.startsWith('/builder')));

        // ---- Referrers ----
        if (refs.length) {
          document.getElementById('ref-section').classList.remove('hidden');
          const maxRef = Number(refs[0].views);
          document.getElementById('referrers').innerHTML = `
            <table class="w-full text-sm">
              <tbody>
                ${refs.map((r) => `
                  <tr class="border-t border-dark-800/40 first:border-t-0">
                    <td class="p-3 text-dark-200 font-mono text-xs w-64 truncate">${esc(r.referrer)}</td>
                    <td class="p-3"><div class="bg-dark-800 rounded h-3"><div class="h-3 rounded bg-biz-500/70" style="width:${Math.round((Number(r.views) / maxRef) * 100)}%"></div></div></td>
                    <td class="p-3 text-right text-white w-20">${Number(r.views).toLocaleString()}</td>
                  </tr>`).join('')}
              </tbody>
            </table>`;
        }

        // ---- Reader actions (outbound clicks) ----
        if (clicks.length) {
          const maxClicks = Number(clicks[0].clicks);
          document.getElementById('tables').insertAdjacentHTML('beforeend', `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">Reader actions — outbound clicks</h2>
            <p class="text-xs text-dark-500 mb-4">Where readers go next: repos, partners, sources.</p>
            <div class="rounded-xl border border-dark-800/50 overflow-hidden">
              <table class="w-full text-sm"><tbody>
                ${clicks.map((c) => `
                  <tr class="border-t border-dark-800/40 first:border-t-0">
                    <td class="p-3 text-dark-200 font-mono text-xs w-64 truncate">${esc(c.target)}</td>
                    <td class="p-3"><div class="bg-dark-800 rounded h-3"><div class="h-3 rounded bg-claw-500/70" style="width:${Math.round((Number(c.clicks) / maxClicks) * 100)}%"></div></div></td>
                    <td class="p-3 text-right text-white w-20">${Number(c.clicks).toLocaleString()}</td>
                  </tr>`).join('')}
              </tbody></table>
            </div>`);
        }

        // ---- Partner performance (the sponsor sales sheet) ----
        const PARTNER_DOMAINS = ['liteit.se', 'www.liteit.se', 'autoversio.ai', 'autoversio.com', 'www.autoversio.ai'];
        const partnerClicks = clicks.filter((c) => PARTNER_DOMAINS.some((d) => c.target === d || c.target.endsWith('.' + d)));
        const sponsorPage = rows.find((r) => r.path === '/builder/37-sponsors');
        if (partnerClicks.length || sponsorPage) {
          document.getElementById('tables').insertAdjacentHTML('beforeend', `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">Partner performance</h2>
            <p class="text-xs text-dark-500 mb-4">Partners chapter reach and clicks to partner sites — from any page in the book.</p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                <div class="text-2xl font-bold text-white">${sponsorPage ? Number(sponsorPage.views).toLocaleString() : '0'}</div>
                <div class="text-xs text-dark-400 mt-1">Partners chapter views</div>
              </div>
              <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                <div class="text-2xl font-bold text-white">${sponsorPage ? `${sponsorPage.completion_pct}%` : '—'}</div>
                <div class="text-xs text-dark-400 mt-1">Chapter completion</div>
              </div>
              <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                <div class="text-2xl font-bold text-white">${partnerClicks.reduce((s, c) => s + Number(c.clicks), 0).toLocaleString()}</div>
                <div class="text-xs text-dark-400 mt-1">Clicks to partner sites</div>
              </div>
              <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                <div class="text-sm font-semibold text-white leading-relaxed">${partnerClicks.map((c) => `${esc(c.target)}: ${c.clicks}`).join('<br>') || '—'}</div>
                <div class="text-xs text-dark-400 mt-1">By destination</div>
              </div>
            </div>`);
        }

        // ---- Reading rhythm (weekday × hour, Swedish time) ----
        if (hours.length) {
          const byDow = Array.from({ length: 7 }, () => 0);
          const byHour = Array.from({ length: 24 }, () => 0);
          hours.forEach((h) => { byDow[h.dow - 1] += Number(h.views); byHour[h.hour] += Number(h.views); });
          const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
          const maxD = Math.max(...byDow, 1); const maxH = Math.max(...byHour, 1);
          document.getElementById('tables').insertAdjacentHTML('beforeend', `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">Reading rhythm</h2>
            <p class="text-xs text-dark-500 mb-4">When the audience reads (Swedish time). Useful for publishing cadence — and for sponsors.</p>
            <div class="grid md:grid-cols-2 gap-4">
              <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                <h3 class="text-sm font-semibold text-white mb-3">By weekday</h3>
                ${byDow.map((v, i) => `
                  <div class="flex items-center gap-2 text-xs mb-1.5">
                    <span class="w-8 text-dark-400">${days[i]}</span>
                    <div class="flex-1 bg-dark-800 rounded h-2.5"><div class="h-2.5 rounded bg-claw-500/70" style="width:${Math.round((100 * v) / maxD)}%"></div></div>
                    <span class="w-10 text-right text-dark-300">${v}</span>
                  </div>`).join('')}
              </div>
              <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                <h3 class="text-sm font-semibold text-white mb-3">By hour</h3>
                <div class="flex items-end gap-0.5 h-24">
                  ${byHour.map((v, i) => `<div class="flex-1 rounded-t bg-biz-500/70" title="${i}:00 — ${v} views" style="height:${Math.max(3, Math.round((100 * v) / maxH))}%"></div>`).join('')}
                </div>
                <div class="flex justify-between text-[10px] text-dark-500 mt-1"><span>00</span><span>06</span><span>12</span><span>18</span><span>23</span></div>
              </div>
            </div>`);
        }

        // ---- Listening (audio) ----
        if (listens.length) {
          const totalStarts = listens.reduce((s, l) => s + Number(l.starts), 0);
          const mobileStarts = listens.reduce((s, l) => s + Number(l.mobile_starts || 0), 0);
          const withTime = listens.filter((l) => l.avg_listen_seconds != null);
          const maxStarts = Math.max(...listens.map((l) => Number(l.starts)), 1);
          document.getElementById('tables').insertAdjacentHTML('beforeend', `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">Listening — audio playback</h2>
            <p class="text-xs text-dark-500 mb-4">${totalStarts.toLocaleString()} listen starts · ${Math.round((100 * mobileStarts) / Math.max(totalStarts, 1))}% on mobile. If these numbers grow, premium pre-generated audio earns its build.</p>
            <div class="rounded-xl border border-dark-800/50 overflow-hidden">
              <table class="w-full text-sm">
                <thead class="bg-dark-900/60 text-dark-400 text-left">
                  <tr><th class="p-3">Chapter</th><th class="p-3 text-right">Starts</th><th class="p-3 text-right">Avg listened</th><th class="p-3"></th></tr>
                </thead>
                <tbody>
                  ${listens.slice(0, 12).map((l) => `
                    <tr class="border-t border-dark-800/40">
                      <td class="p-3 text-dark-200 font-mono text-xs">${esc(l.path)}</td>
                      <td class="p-3 text-right text-white">${Number(l.starts).toLocaleString()}</td>
                      <td class="p-3 text-right text-dark-300">${l.avg_listen_seconds != null ? Math.floor(l.avg_listen_seconds / 60) + 'm ' + (l.avg_listen_seconds % 60) + 's' : '—'}</td>
                      <td class="p-3 w-32"><div class="bg-dark-800 rounded h-2.5"><div class="h-2.5 rounded bg-claw-500/70" style="width:${Math.round((100 * Number(l.starts)) / maxStarts)}%"></div></div></td>
                    </tr>`).join('')}
                </tbody>
              </table>
            </div>`);
        }

        // ---- Agent readers (MCP usage) ----
        if (agents.length) {
          const byKind = (k) => agents.filter((a) => a.kind === k);
          const connects = byKind('connect');
          const reads = byKind('read');
          const searches = byKind('search');
          const totalConnects = connects.reduce((s, a) => s + Number(a.events), 0);
          const col = (title, list, color, empty) => `
            <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
              <h3 class="text-sm font-semibold text-white mb-3">${title}</h3>
              ${!list.length ? `<p class="text-dark-500 text-xs">${empty}</p>` : list.slice(0, 8).map((a) => {
                const max = Number(list[0].events);
                return `
                  <div class="flex items-center gap-2 text-xs mb-1.5">
                    <span class="w-36 shrink-0 truncate font-mono text-dark-400" title="${esc(a.detail)}">${esc(a.detail)}</span>
                    <div class="flex-1 bg-dark-800 rounded h-2.5"><div class="h-2.5 rounded ${color}" style="width:${Math.round((100 * Number(a.events)) / max)}%"></div></div>
                    <span class="w-8 text-right text-dark-300">${a.events}</span>
                  </div>`;
              }).join('')}
            </div>`;
          document.getElementById('tables').insertAdjacentHTML('beforeend', `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">Agent readers — MCP</h2>
            <p class="text-xs text-dark-500 mb-4">${totalConnects.toLocaleString()} agent connections. The handbook's second audience: software reading for its humans.</p>
            <div class="grid md:grid-cols-3 gap-4">
              ${col('Connections by client', connects, 'bg-claw-500/70', 'No connections yet.')}
              ${col('Chapters read by agents', reads, 'bg-biz-500/70', 'No agent reads yet.')}
              ${col('What agents search for', searches, 'bg-claw-500/50', 'No searches yet.')}
            </div>`);
        }

        // ---- Who reads (survey answers) ----
        if (survey.length) {
          const labels = { role: 'What best describes you?', stage: 'Where on agentic AI?', intent: 'Project within 6 months?' };
          const byQ = {};
          survey.forEach((s) => { (byQ[s.question] = byQ[s.question] || []).push(s); });
          document.getElementById('tables').insertAdjacentHTML('beforeend', `
            <h2 class="text-xl font-semibold text-white mt-10 mb-1">Who reads — survey answers</h2>
            <p class="text-xs text-dark-500 mb-4">Optional 3-tap card, anonymous. Shown once per reader from their second chapter.</p>
            <div class="grid md:grid-cols-3 gap-4">
              ${Object.entries(byQ).map(([q, list]) => {
                const total = list.reduce((s, r) => s + Number(r.answers), 0);
                return `
                  <div class="rounded-xl bg-dark-900/40 border border-dark-800/50 p-4">
                    <h3 class="text-sm font-semibold text-white mb-3">${esc(labels[q] || q)}</h3>
                    ${list.sort((a, b) => b.answers - a.answers).map((r) => `
                      <div class="flex items-center gap-2 text-xs mb-1.5">
                        <span class="w-20 shrink-0 text-dark-400">${esc(r.answer)}</span>
                        <div class="flex-1 bg-dark-800 rounded h-2.5"><div class="h-2.5 rounded bg-biz-500/70" style="width:${Math.round((100 * Number(r.answers)) / total)}%"></div></div>
                        <span class="w-10 text-right text-dark-300">${Math.round((100 * Number(r.answers)) / total)}%</span>
                      </div>`).join('')}
                    <p class="text-[10px] text-dark-500 mt-2">${total} answers</p>
                  </div>`;
              }).join('')}
            </div>`);
        }

        statusEl.textContent = `Based on ${totalViews.toLocaleString()} anonymous page views.`;
      } catch (e) {
        statusEl.textContent = `Could not load analytics: ${e.message}`;
      }
    })();
  </script>
</Base>
