---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = 'The Agentic AI Handbook';
const description = 'An open-source field report on autonomous AI agents. On April 19, 2026, an agent nobody prompted surfaced over €1.1 million in exposure in a live business. Two editions: a logged report for business leaders and an architecture guide for builders.';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Clawable — The Agentic AI Handbook',
    url: Astro.url.origin,
    description,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: title,
    abstract: description,
    url: Astro.url.toString(),
    inLanguage: 'en',
    author: {
      '@type': 'Organization',
      name: 'Clawable',
    },
    about: ['Agentic AI', 'Autonomous agents', 'Business Operating System', 'OpenClaw'],
  },
];
---

<Base title={title} description={description} image="/og-cover.png" structuredData={structuredData}>
  <Nav />
  <main>
    <!-- Umbrella Hero -->
    <section class="relative pt-24 md:pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-white/2 via-transparent to-transparent pointer-events-none" />
      <div class="absolute top-20 left-1/4 w-[600px] h-[600px] bg-biz-500/4 rounded-full blur-3xl pointer-events-none" />
      <div class="absolute top-20 right-1/4 w-[600px] h-[600px] bg-claw-500/4 rounded-full blur-3xl pointer-events-none" />

      <div class="relative max-w-6xl mx-auto px-6 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-dark-300 text-sm font-medium mb-6 md:mb-8">
          <span class="w-2 h-2 rounded-full bg-white/40 animate-pulse" />
          Open Source &middot; Free Forever &middot; Updated November 2026
        </div>

        <h1 class="text-4xl md:text-7xl font-bold text-white tracking-tight leading-[1.1] mb-6">
          The Agentic AI<br />
          <span class="bg-gradient-to-r from-biz-400 via-white to-claw-400 bg-clip-text text-transparent">Handbook</span>
        </h1>

        <p class="text-xl md:text-2xl text-dark-300 leading-relaxed mb-6 max-w-2xl mx-auto">
          On April 19, 2026, an agent nobody prompted went through a live business and surfaced over <strong class="text-white">€1.1 million in exposure</strong>. First finding: 44 seconds.
        </p>

        <div class="flex flex-wrap justify-center gap-3 mb-6">
          <a href="/business/03-live-proof" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-biz-500 hover:bg-biz-600 text-white font-semibold transition-colors">
            Read the proof
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#editions" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-dark-800 hover:bg-dark-700 text-white font-semibold transition-colors border border-dark-700">
            Choose your edition
          </a>
        </div>

        <p class="text-base text-dark-500 mb-16 max-w-xl mx-auto">
          The open-source field report on autonomous agents: what happened, why it works, and how to build it — logged, evidence-tagged, and free.
        </p>

        <!-- Edition cards -->
        <div id="editions" class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto scroll-mt-24">
          <!-- Business Edition -->
          <a href="/business" class="group relative rounded-2xl overflow-hidden border border-biz-500/20 hover:border-biz-500/50 bg-gradient-to-br from-dark-900/80 to-biz-950/30 hover:from-dark-900/60 hover:to-biz-950/50 transition-all duration-300 p-8 text-left">
            <div class="absolute inset-0 bg-gradient-to-br from-biz-500/5 to-transparent pointer-events-none" />
            <div class="relative">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-biz-500/10 border border-biz-500/20 text-biz-400 text-xs font-medium mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-biz-400" />
                For Business — C-level Leaders
              </div>

              <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 group-hover:text-biz-100 transition-colors">
                Business Edition
              </h2>
              <p class="text-dark-400 leading-relaxed mb-6 text-sm">
                An evidence-based field report — not a pitch. What autonomous agents are doing to business operating systems right now, proven in production with real numbers and timestamps. Built for CEOs, CFOs, and CPOs who need to understand what just changed and what to do about it.
              </p>

              <div class="grid grid-cols-3 gap-3 mb-6">
                <div class="rounded-lg bg-biz-500/10 p-3">
                  <div class="text-lg font-bold text-white">17</div>
                  <div class="text-xs text-dark-500">Chapters</div>
                </div>
                <div class="rounded-lg bg-biz-500/10 p-3">
                  <div class="text-lg font-bold text-white">€1.1M</div>
                  <div class="text-xs text-dark-500">Surfaced day 1</div>
                </div>
                <div class="rounded-lg bg-biz-500/10 p-3">
                  <div class="text-lg font-bold text-white">Live</div>
                  <div class="text-xs text-dark-500">Production proof</div>
                </div>
              </div>

              <div class="inline-flex items-center gap-2 text-biz-400 font-semibold text-sm group-hover:text-biz-300 transition-colors">
                Read Business Edition
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>

          <!-- Builder Edition -->
          <a href="/builder" class="group relative rounded-2xl overflow-hidden border border-claw-500/20 hover:border-claw-500/50 bg-gradient-to-br from-dark-900/80 to-claw-950/30 hover:from-dark-900/60 hover:to-claw-950/50 transition-all duration-300 p-8 text-left">
            <div class="absolute inset-0 bg-gradient-to-br from-claw-500/5 to-transparent pointer-events-none" />
            <div class="relative">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-claw-500/10 border border-claw-500/20 text-claw-400 text-xs font-medium mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-claw-400" />
                For Builders — CTOs &amp; Engineers
              </div>

              <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 group-hover:text-claw-100 transition-colors">
                Builder Edition
              </h2>
              <p class="text-dark-400 leading-relaxed mb-6 text-sm">
                The technical architecture guide. OpenClaw internals, governance patterns, heartbeat protocols, memory architecture, A2A federation, agent-driven development, and production resilience — everything you need to build and operate autonomous agents at scale.
              </p>

              <div class="grid grid-cols-3 gap-3 mb-6">
                <div class="rounded-lg bg-claw-500/10 p-3">
                  <div class="text-lg font-bold text-white">38</div>
                  <div class="text-xs text-dark-500">Chapters</div>
                </div>
                <div class="rounded-lg bg-claw-500/10 p-3">
                  <div class="text-lg font-bold text-white">10</div>
                  <div class="text-xs text-dark-500">Agentic laws</div>
                </div>
                <div class="rounded-lg bg-claw-500/10 p-3">
                  <div class="text-lg font-bold text-white">A2A</div>
                  <div class="text-xs text-dark-500">Federation ready</div>
                </div>
              </div>

              <div class="inline-flex items-center gap-2 text-claw-400 font-semibold text-sm group-hover:text-claw-300 transition-colors">
                Read Builder Edition
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>

          <!-- Edition 3 — Teaser -->
          <div class="group relative rounded-2xl overflow-hidden border border-learn-500/15 bg-gradient-to-br from-dark-900/60 to-learn-950/20 p-8 text-left">
            <div class="absolute inset-0 bg-gradient-to-br from-learn-500/4 to-transparent pointer-events-none" />
            <!-- Coming soon overlay shimmer -->
            <div class="absolute top-4 right-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-learn-500/10 border border-learn-500/20 text-learn-400 text-xs font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-learn-400 animate-pulse" />
                In research
              </span>
            </div>
            <div class="relative">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-learn-500/10 border border-learn-500/20 text-learn-400 text-xs font-medium mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-learn-500/50" />
                Edition 3 — For Those Already Operating
              </div>

              <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 opacity-90">
                The Learning Operator
              </h2>
                <p class="text-dark-500 leading-relaxed mb-6 text-sm">
                 An operator deployed now runs your business. An operator built on <strong class="text-dark-400">Hermes</strong> — NousResearch's learning-loop successor to OpenClaw — gets better at running it. Skills created from experience. Skills that self-improve during use. The third handbook documents what happens when the operator starts building its own capabilities — based on live Business Operating System simulations running now.
               </p>

              <div class="grid grid-cols-3 gap-3 mb-6">
                <div class="rounded-lg bg-learn-500/8 border border-learn-500/10 p-3">
                  <div class="text-lg font-bold text-dark-400">Hermes</div>
                  <div class="text-xs text-dark-600">Open runtime</div>
                </div>
                <div class="rounded-lg bg-learn-500/8 border border-learn-500/10 p-3">
                  <div class="text-lg font-bold text-dark-400">Learning</div>
                  <div class="text-xs text-dark-600">Built-in loop</div>
                </div>
                <div class="rounded-lg bg-learn-500/8 border border-learn-500/10 p-3">
                   <div class="text-lg font-bold text-dark-400">In research</div>
                   <div class="text-xs text-dark-600">Status</div>
                </div>
              </div>

              <div class="inline-flex items-center gap-2 text-learn-500/60 font-semibold text-sm cursor-default select-none">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                In research — notify when published
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Shared context -->
    <section class="py-20 border-t border-dark-800/50">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-dark-500 text-sm uppercase tracking-widest font-medium mb-6">What happened in January 2026</p>
        <p class="text-xl md:text-2xl text-dark-300 leading-relaxed mb-8 max-w-2xl mx-auto">
          An Austrian developer pushed three text files to GitHub. In six weeks it passed 346,000 stars. OpenAI adopted the protocol within months.
        </p>
        <p class="text-dark-400 leading-relaxed max-w-2xl mx-auto">
           Any SaaS platform that exposes MCP can now be operated autonomously by an agent. Not with months of custom integration. With a standard protocol and a configuration file. The Business Edition explains what that means for your company. The Builder Edition explains how to build it. The third handbook, now in research, will document what the operator learns once it has been running long enough.
        </p>
      </div>
    </section>

    <!-- Agent-readable: connect your agent -->
    <section class="py-20 border-t border-dark-800/50">
      <div class="max-w-4xl mx-auto px-6">
        <div class="rounded-2xl bg-dark-900/50 border border-claw-500/20 p-8 md:p-10">
          <p class="text-claw-400 text-xs uppercase tracking-widest font-medium mb-4">Agent-readable · MCP</p>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Don't just read it. Let your agent read it.</h2>
          <p class="text-dark-300 leading-relaxed mb-6 max-w-2xl">
            The fastest way to start your agentic AI journey is to delegate the reading. The entire handbook — all 70 chapters, both editions — is exposed over MCP. Connect your agent and it becomes your transformation partner: it searches the evidence, reads the chapters that match <em>your</em> stack, and answers with the handbook's proof behind it.
          </p>

          <div class="rounded-xl bg-dark-950 border border-dark-800 p-4 mb-3 flex items-center justify-between gap-4">
            <code class="text-sm text-claw-300 font-mono overflow-x-auto whitespace-nowrap" id="mcp-snippet">claude mcp add --transport http clawable https://www.clawable.org/api/mcp</code>
            <button id="mcp-copy" class="shrink-0 text-xs px-3 py-1.5 rounded-lg bg-claw-500/10 border border-claw-500/30 text-claw-300 hover:bg-claw-500/20 transition-colors">Copy</button>
          </div>
          <p class="text-dark-500 text-xs mb-6">
            Claude Code shown — any MCP client works: point OpenClaw, Hermes, or your own operator at <code class="text-dark-400">https://www.clawable.org/api/mcp</code> (Streamable HTTP). No key needed. Prefer plain fetch? <a href="/llms.txt" class="text-claw-400 hover:text-claw-300">llms.txt</a> lists every chapter as raw markdown.
          </p>

          <p class="text-dark-400 text-sm font-medium mb-3">Then ask your agent things like:</p>
          <div class="grid md:grid-cols-3 gap-3 mb-6">
            <div class="rounded-lg bg-dark-900/60 border border-dark-800/60 p-3 text-sm text-dark-300">"Summarize the business case for my board — with the evidence tags."</div>
            <div class="rounded-lg bg-dark-900/60 border border-dark-800/60 p-3 text-sm text-dark-300">"Draft a first AGENTS.md mandate for our finance workflow, based on chapter 14."</div>
            <div class="rounded-lg bg-dark-900/60 border border-dark-800/60 p-3 text-sm text-dark-300">"Which chapters apply to a company running Salesforce and Fortnox?"</div>
          </div>

          <p class="text-white font-semibold">Your agentic AI journey starts today — with an agent reading the handbook.</p>
        </div>
      </div>
      <script is:inline>
        document.getElementById('mcp-copy')?.addEventListener('click', function () {
          const text = document.getElementById('mcp-snippet').textContent;
          const done = () => {
            this.textContent = 'Copied ✓';
            setTimeout(() => { this.textContent = 'Copy'; }, 2000);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(() => {
              window.getSelection().selectAllChildren(document.getElementById('mcp-snippet'));
              done();
            });
          } else {
            window.getSelection().selectAllChildren(document.getElementById('mcp-snippet'));
            done();
          }
        });
      </script>
    </section>

    <!-- Partner / Endorsement placeholder -->
    <section class="py-16 border-t border-dark-800/30">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <p class="text-dark-600 text-xs uppercase tracking-widest font-medium mb-8">Built with</p>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-50">
          <span class="text-dark-400 text-sm font-medium">OpenClaw</span>
          <span class="text-dark-700">·</span>
          <span class="text-dark-400 text-sm font-medium">FlowWink</span>
          <span class="text-dark-700">·</span>
          <span class="text-dark-400 text-sm font-medium">AgentHotel</span>
          <span class="text-dark-700">·</span>
          <span class="text-dark-400 text-sm font-medium">Astro</span>
          <span class="text-dark-700">·</span>
          <span class="text-dark-400 text-sm font-medium">Kilo Code</span>
          <span class="text-dark-700">·</span>
          <span class="text-dark-400 text-sm font-medium">Lovable</span>
          <span class="text-dark-700">·</span>
          <span class="text-dark-400 text-sm font-medium">Vercel</span>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
